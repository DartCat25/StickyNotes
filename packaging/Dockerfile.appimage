FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    APPIMAGE_EXTRACT_AND_RUN=1 \
    ARCH=x86_64 \
    PATH=/opt/appimage-tools:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        file \
        libgl1-mesa-dev \
        libx11-dev \
        libxcb1-dev \
        libxext-dev \
        patchelf \
        pkg-config \
        qt6-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Same bounded download logic as the native path: a stalled GitHub release
# download fails and retries instead of hanging the build forever.
COPY install-appimage-tools.sh /usr/local/share/stickynotes/install-appimage-tools.sh
RUN bash /usr/local/share/stickynotes/install-appimage-tools.sh /opt/appimage-tools

WORKDIR /src
